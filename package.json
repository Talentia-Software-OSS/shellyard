{
  "name": "@talentiaoss/shellyard",
  "version": "0.2.5",
  "description": "ShellYard: run Claude Code sessions and shells in one local browser page, and see which one needs you.",
  "type": "module",
  "bin": {
    "shellyard": "dist/cli/shellyard.js"
  },
  "exports": {
    "./launcher": "./dist/cli/shellyard.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:server": "tsx src/cli/shellyard.ts --foreground",
    "dev:web": "vite",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "pty",
    "xterm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talentia-Software-OSS/shellyard.git"
  },
  "homepage": "https://github.com/Talentia-Software-OSS/shellyard#readme",
  "bugs": {
    "url": "https://github.com/Talentia-Software-OSS/shellyard/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "open": "^11.0.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
